# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/kutuzov_i_lab_3_BACKEND%shlibext \
# RUN: -run-pass=kutuzov_inline-x86 %s -o - | FileCheck %s


# CHECK-LABEL: name: self_rec
# CHECK: ADD32ri
# CHECK: ADD32ri
# CHECK: ADD32ri
# CHECK: ADD32ri
# CHECK: CALL64pcrel32
# CHECK: RET64
---
name:            self_rec
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $ecx
    %3:gr32 = COPY $ecx
    %4:gr32 = ADD32ri %3, 13, implicit-def $eflags
    $ecx = COPY %4
    CALL64pcrel32 @self_rec, implicit $ecx, implicit-def $eax
    RET64
...

# CHECK-LABEL: name: leaf_caller
# CHECK: IMUL32rri8
# CHECK-NOT: CALL64pcrel32
# CHECK: RET64
---
name:            leaf_callee
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $edx
    %7:gr32 = COPY $edx
    %8:gr32 = IMUL32rri8 %7, 5, implicit-def $eflags
    $eax = COPY %8
    RET64
...
---
name:            leaf_caller
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $edx
    CALL64pcrel32 @leaf_callee, implicit $edx, implicit-def $eax
    RET64
...

# CHECK-LABEL: name: outer
# CHECK: %1:gr32 = AND32ri %0, 7
# CHECK: %3:gr32 = SUB32ri %2, 2
# CHECK: %5:gr32 = XOR32ri %4, 42
# CHECK-NOT: CALL64pcrel32
# CHECK: RET64
---
name:            inner_final
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $edi
    %200:gr32 = COPY $edi
    %201:gr32 = XOR32ri %200, 42, implicit-def $eflags
    $eax = COPY %201
    RET64
...
---
name:            middle
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $edi
    %30:gr32 = COPY $edi
    %31:gr32 = SUB32ri %30, 2, implicit-def $eflags
    $edi = COPY %31
    CALL64pcrel32 @inner_final, implicit $edi, implicit-def $eax
    RET64
...
---
name:            outer
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = AND32ri %0, 7, implicit-def $eflags
    $edi = COPY %1
    CALL64pcrel32 @middle, implicit $edi, implicit-def $eax
    RET64
...

# CHECK-LABEL: name: caller_big
# CHECK: CALL64pcrel32
# CHECK: RET64
---
name:            callee_big
tracksRegLiveness: true
body:             |
  bb.0:
    %0:gr32 = MOV32ri 13
    %1:gr32 = ADD32ri %0, 7, implicit-def $eflags
    %2:gr32 = SUB32ri %1, 2, implicit-def $eflags
    %3:gr32 = IMUL32rri8 %2, 3, implicit-def $eflags
    %4:gr32 = AND32ri %3, 15, implicit-def $eflags
    %5:gr32 = OR32ri %4, 8, implicit-def $eflags
    %6:gr32 = XOR32ri %5, 1, implicit-def $eflags
    %7:gr32 = ADD32ri %6, 9, implicit-def $eflags
    %8:gr32 = SUB32ri %7, 5, implicit-def $eflags
    %9:gr32 = IMUL32rri8 %8, 6, implicit-def $eflags
    %10:gr32 = AND32ri %9, 31, implicit-def $eflags
    %11:gr32 = OR32ri %10, 12, implicit-def $eflags
    %12:gr32 = XOR32ri %11, 3, implicit-def $eflags
    %13:gr32 = ADD32ri %12, 11, implicit-def $eflags
    %14:gr32 = SUB32ri %13, 4, implicit-def $eflags
    RET64
...
---
name:            caller_big
tracksRegLiveness: true
body:             |
  bb.0:
    CALL64pcrel32 @callee_big, implicit-def $eax
    RET64
...

# CHECK-LABEL: name: caller_almost_big
# CHECK-NOT: CALL64pcrel32
# CHECK: RET64
---
name:            callee_almost_big
tracksRegLiveness: true
body:             |
  bb.0:
    %0:gr32 = MOV32ri 13
    %1:gr32 = ADD32ri %0, 7, implicit-def $eflags
    %2:gr32 = SUB32ri %1, 2, implicit-def $eflags
    %3:gr32 = IMUL32rri8 %2, 3, implicit-def $eflags
    %4:gr32 = AND32ri %3, 15, implicit-def $eflags
    %5:gr32 = OR32ri %4, 8, implicit-def $eflags
    %6:gr32 = XOR32ri %5, 1, implicit-def $eflags
    %7:gr32 = ADD32ri %6, 9, implicit-def $eflags
    %8:gr32 = SUB32ri %7, 5, implicit-def $eflags
    %9:gr32 = IMUL32rri8 %8, 6, implicit-def $eflags
    %10:gr32 = AND32ri %9, 31, implicit-def $eflags
    %11:gr32 = OR32ri %10, 12, implicit-def $eflags
    %12:gr32 = XOR32ri %11, 3, implicit-def $eflags
    %13:gr32 = ADD32ri %12, 11, implicit-def $eflags
    RET64
...
---
name:            caller_almost_big
tracksRegLiveness: true
body:             |
  bb.0:
    CALL64pcrel32 @callee_almost_big, implicit-def $eax
    RET64
...
